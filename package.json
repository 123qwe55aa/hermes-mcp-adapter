{
  "name": "hermes-mcp-adapter",
  "version": "0.1.0",
  "description": "Self-hosted MCP adapter for a local Hermes runtime.",
  "type": "module",
  "private": true,
  "bin": {
    "hermes-mcp-adapter": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
