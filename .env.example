# Absolute path. Everything outside this path is blocked.
WORKSPACE_ROOT=/Users/toby/Documents/Projects

# Hermes local runtime, if you want HTTP forwarding mode.
HERMES_BASE_URL=http://127.0.0.1:9119
HERMES_HTTP_TIMEOUT_MS=10000

# local = adapter executes safe fs/shell actions itself
# http = adapter validates locally, then forwards to Hermes HTTP endpoints
HERMES_MODE=local

# stdio = MCP over stdin/stdout (for ChatGPT Desktop etc.)
# http = MCP over HTTP/SSE (for remote access via Cloudflare Tunnel)
TRANSPORT=stdio
HTTP_PORT=3000

# Optional Bearer token for HTTP /mcp endpoint. When set, all MCP requests
# must include Authorization: Bearer *** Strongly recommended before
# exposing the HTTP server to a network or Cloudflare Tunnel.
# MCP_AUTH_TOKEN=your-secret-token

# First token of the command must be in this list.
# Keep this narrow; risky tools such as cat/node/python3 are intentionally not enabled by default.
COMMAND_ALLOWLIST=ls,pwd,rg,git,npm

# npm is further restricted to npm test and npm run <script> where <script> is allowlisted here.
NPM_SCRIPT_ALLOWLIST=test,typecheck,build,lint

COMMAND_TIMEOUT_MS=20000
MAX_FILE_BYTES=262144
