# Absolute path. Everything outside this path is blocked.
WORKSPACE_ROOT=/Users/toby/Documents/Projects

# Hermes local runtime, if you want HTTP forwarding mode.
HERMES_BASE_URL=http://127.0.0.1:9119

# local = adapter executes safe fs/shell actions itself
# http = adapter forwards to Hermes HTTP endpoints
HERMES_MODE=local

# First token of the command must be in this list.
COMMAND_ALLOWLIST=ls,pwd,cat,grep,rg,git,npm,pnpm,node,python3

COMMAND_TIMEOUT_MS=20000
MAX_FILE_BYTES=262144
